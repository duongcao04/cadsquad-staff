{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"sourceRoot": "src",
	"compilerOptions": {
		"deleteOutDir": true,
		"assets": [
			{
				"include": "templates/**/*",
				"outDir": "dist/templates",
				"watchAssets": true
			},
			{
				"include": "generated/**/*",
				"outDir": "dist/src",
				"watchAssets": true
			},
			{
				"include": "config/**/*",
				"outDir": "dist/src",
				"watchAssets": true
			}
		]
	}
}